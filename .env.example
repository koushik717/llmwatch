# LLMWatch Environment Variables
# Copy this file to .env and fill in your values.
# docker-compose automatically reads .env

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=llmwatch
POSTGRES_USER=llmwatch
POSTGRES_PASSWORD=llmwatch_secret

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_TOPIC=llm-events
KAFKA_GROUP_ID=llm-metrics-consumer

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Application (override for local dev outside Docker) ─────────────────────
# DATABASE_URL=postgres://llmwatch:llmwatch_secret@localhost:5432/llmwatch?sslmode=disable
# REDIS_URL=localhost:6379
# KAFKA_BROKERS=localhost:29092
# API_PORT=8080
